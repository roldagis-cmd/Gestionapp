# Copiá este archivo como .env para desarrollo local. Nunca subas el .env al repositorio.
DATABASE_URL=postgres://usuario:clave@localhost:5432/gestionapp
# Clave para firmar las sesiones (cualquier texto largo y aleatorio)
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio
# Clave maestra para cifrar los certificados de ARCA: 32 bytes en base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
MASTER_KEY=
# Envío de los códigos de ingreso por email (Brevo). Sin esto, en desarrollo el código se muestra en la consola.
BREVO_API_KEY=
MAIL_FROM=
# Clave de la API de Claude para leer comprobantes (opcional: sin ella se desactiva la lectura)
ANTHROPIC_API_KEY=
PORT=3000
